# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Behind a reverse proxy only: the header it fills in with the client's IP (e.g. X-Forwarded-For).
# Leave empty without a proxy (clients can fake headers). Used by the login lockout and the
# public registration rate limit.
TRUSTED_PROXY_HEADER=

# Where startup data comes from (Step 7). The mock reads invented data; Navigatu is a later phase.
STARTUP_PROVIDER=startups.providers.MockStartupProvider

# PostgreSQL (used by both docker-compose.yml and Django)
POSTGRES_DB=csu_tbi_track
POSTGRES_USER=csu_tbi
POSTGRES_PASSWORD=change-me
# 127.0.0.1, not localhost: Docker publishes the port on 127.0.0.1 (IPv4) only, and "localhost" may
# try IPv6 (::1) first, which makes every connection wait about 30 seconds on Windows.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Gemini (google-genai)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Public address of the site (placeholder): every shared link uses it, in emails, on the activity
# page's Share card and in its QR codes. On the server: the real https:// address, without a trailing slash.
SITE_URL=http://127.0.0.1:8000
# Contact address in the footer of the public pages (placeholder until the TBI confirms it)
TBI_CONTACT_EMAIL=tbi.contact@example.com

# Email (Step 9). While DJANGO_DEBUG=True emails are printed in the terminal unless
# EMAIL_REAL_SENDING=True. Addresses @demo.example.com are never really emailed.
# Gmail: EMAIL_HOST_PASSWORD must be an App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal password.
# Test with: python manage.py send_test_email you@example.com --smtp
DEFAULT_FROM_EMAIL=CSU-TBI Track <no-reply@localhost>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_REAL_SENDING=False

# First Admin account, created by `python manage.py seed_data`.
# The password is only used when the account is first created; change it after logging in.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=TBI Admin
