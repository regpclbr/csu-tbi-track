# Copy this file to .env and fill in real values. Never commit .env.
# Development (Windows): the values below as they are. The hosted review version (one Azure server): see the
# "ON THE SERVER" notes and docs/DEPLOY.md, step 6; the server's file is /opt/csu-tbi/.env (root only, mode 600).

# Django
# ON THE SERVER: a new random key (python -c "import secrets; print(secrets.token_urlsafe(50))"), DJANGO_DEBUG=False,
# and DJANGO_ALLOWED_HOSTS=<name>.<region>.cloudapp.azure.com
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Behind a reverse proxy only: the header it fills in with the client's IP (e.g. X-Forwarded-For).
# Leave empty without a proxy (clients can fake headers). Used by the login lockout and the
# public registration rate limit. ON THE SERVER (Caddy): X-Forwarded-For
TRUSTED_PROXY_HEADER=
# ON THE SERVER: True (Caddy ends HTTPS and tells Django with X-Forwarded-Proto). Never True without a proxy.
BEHIND_HTTPS_PROXY=False

# PostgreSQL (used by both docker-compose.yml and Django)
# ON THE SERVER: a new long random POSTGRES_PASSWORD. POSTGRES_HOST/PORT are set by deploy/docker-compose.prod.yml.
POSTGRES_DB=csu_tbi_track
POSTGRES_USER=csu_tbi
POSTGRES_PASSWORD=change-me
# 127.0.0.1, not localhost: Docker publishes the port on 127.0.0.1 (IPv4) only, and "localhost" may
# try IPv6 (::1) first, which makes every connection wait about 30 seconds on Windows.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Gemini (google-genai). ON THE SERVER: empty until NAVIGATU approves (docs/DEPLOY.md, "Turn on the AI later").
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Public address of the site (placeholder): every shared link uses it, in emails, on the activity
# page's Share card and in its QR codes. On the server: the real https:// address, without a trailing slash,
# e.g. https://<name>.<region>.cloudapp.azure.com
SITE_URL=http://127.0.0.1:8000
# Contact address in the footer of the public pages (placeholder until the TBI confirms it)
TBI_CONTACT_EMAIL=tbi.contact@example.com
# A small label on the staff pages and the sign-in page. ON THE SERVER: Review version. Empty = no label.
REVIEW_VERSION_LABEL=

# Email (Step 9). While DJANGO_DEBUG=True emails are printed in the terminal unless
# EMAIL_REAL_SENDING=True. Addresses @demo.example.com are never really emailed.
# Gmail: EMAIL_HOST_PASSWORD must be an App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal password.
# Test with: python manage.py send_test_email you@example.com --smtp
# ON THE SERVER: EMAIL_REAL_SENDING=True and DEFAULT_FROM_EMAIL=CSU-TBI Track <the Gmail address> (Gmail replaces any
# other sender address with the account's own).
DEFAULT_FROM_EMAIL=CSU-TBI Track <no-reply@localhost>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_REAL_SENDING=False

# First Admin account, created by `python manage.py seed_data` (development).
# The password is only used when the account is first created; change it after logging in.
# ON THE SERVER: leave all three EMPTY and run create_first_admin instead (it asks; nothing is kept in .env).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=TBI Admin

# --- Only on the server (deploy/docker-compose.prod.yml); development ignores them -------------------------
# The Azure DNS name (no https://, no slash): Caddy gets the free HTTPS certificate for it.
SITE_DOMAIN=
# Caddy's contact email for the certificate provider (expiry warnings). Your own address.
ACME_EMAIL=
# Background worker processes (1 on a 1 GB server) and web server workers/threads.
Q_CLUSTER_WORKERS=2
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
