# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by both docker-compose.yml and Django)
POSTGRES_DB=csu_tbi_track
POSTGRES_USER=csu_tbi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Gemini (google-genai)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Email (SMTP is wired up in Step 9; development prints emails to the console)
DEFAULT_FROM_EMAIL=CSU-TBI Track <no-reply@localhost>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# First Admin account, created by `python manage.py seed_data`.
# The password is only used when the account is first created; change it after logging in.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Tbi!Track-2026-Dev
SEED_ADMIN_NAME=TBI Admin
